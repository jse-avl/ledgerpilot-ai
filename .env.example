# ============================================================
#  LedgerPilot AI — environment
#  Every variable below is optional. With an empty .env the app
#  runs in heuristic mode with an embedded PGlite database.
# ============================================================

# --- App -----------------------------------------------------
APP_URL=http://localhost:3000
# Generated by `pnpm setup` if missing. Required for auth in week 1+.
AUTH_SECRET=

# --- Database (optional) -------------------------------------
# Empty  -> embedded PGlite in .data/pglite
# Set    -> any Postgres 18 (Neon, local, CI). Use a pooled Neon URL on Vercel.
DATABASE_URL=

# --- Storage -------------------------------------------------
# local = .data/storage (default) | r2 = Cloudflare R2
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- AI (all optional) ---------------------------------------
# auto  = cloud key > local Ollama > heuristic
# mock  = force heuristic/deterministic components
# local = require Ollama, fail loudly if missing
# cloud = require a cloud key, fail loudly if missing
AI_MODE=auto

# Ollama (OpenAI-compatible endpoint)
AI_LOCAL_BASE_URL=http://localhost:11434/v1
AI_LOCAL_VISION_MODEL=qwen3-vl:4b
AI_LOCAL_TEXT_MODEL=qwen3:4b
AI_LOCAL_EMBEDDING_MODEL=embeddinggemma-2:270m

# Cloud providers (any subset)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model routing (optional overrides)
AI_EXTRACTION_MODEL=gemini-3.8-flash
AI_REASONING_MODEL=gpt-6.1-sol
AI_EMBEDDING_MODEL=gemini-embedding-2

# --- Observability (optional) --------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- MCP -----------------------------------------------------
MCP_RESOURCE=https://api.ledgerpilot.dev/mcp
MCP_PORT=3100
# Workspace served by this MCP instance: northwind | cafe-americana |
# pacific-logistics. Empty means the first seeded workspace.
MCP_TENANT=

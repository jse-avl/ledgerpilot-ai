{
  "name": "@ledgerpilot/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stateless MCP server exposing LedgerPilot read tools and two-phase write proposals.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@ledgerpilot/agent": "workspace:*",
    "@ledgerpilot/core": "workspace:*",
    "@ledgerpilot/db": "workspace:*",
    "@modelcontextprotocol/server": "^2.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
